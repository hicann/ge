#include "kernel_operator.h"

namespace {
constexpr int32_t kBlockLength = 1024;
constexpr int32_t kTileNum = 8;
constexpr int32_t kBufferNum = 2;
}

class KernelAdd {
 public:
  __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z) {
    x_gm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(x) +
                              kBlockLength * AscendC::GetBlockIdx(),
                          kBlockLength);
    y_gm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(y) +
                              kBlockLength * AscendC::GetBlockIdx(),
                          kBlockLength);
    z_gm_.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(z) +
                              kBlockLength * AscendC::GetBlockIdx(),
                          kBlockLength);
    tile_length_ = kBlockLength / kTileNum / kBufferNum;
    pipe_.InitBuffer(input_x_, kBufferNum, tile_length_ * sizeof(float));
    pipe_.InitBuffer(input_y_, kBufferNum, tile_length_ * sizeof(float));
    pipe_.InitBuffer(output_z_, kBufferNum, tile_length_ * sizeof(float));
  }

  __aicore__ inline void Process() {
    for (int32_t index = 0; index < kTileNum * kBufferNum; ++index) {
      CopyIn(index);
      Compute();
      CopyOut(index);
    }
  }

 private:
  __aicore__ inline void CopyIn(int32_t index) {
    auto x_local = input_x_.AllocTensor<float>();
    auto y_local = input_y_.AllocTensor<float>();
    AscendC::DataCopy(x_local, x_gm_[index * tile_length_], tile_length_);
    AscendC::DataCopy(y_local, y_gm_[index * tile_length_], tile_length_);
    input_x_.EnQue(x_local);
    input_y_.EnQue(y_local);
  }

  __aicore__ inline void Compute() {
    auto x_local = input_x_.DeQue<float>();
    auto y_local = input_y_.DeQue<float>();
    auto z_local = output_z_.AllocTensor<float>();
    AscendC::Add(z_local, x_local, y_local, tile_length_);
    output_z_.EnQue(z_local);
    input_x_.FreeTensor(x_local);
    input_y_.FreeTensor(y_local);
  }

  __aicore__ inline void CopyOut(int32_t index) {
    auto z_local = output_z_.DeQue<float>();
    AscendC::DataCopy(z_gm_[index * tile_length_], z_local, tile_length_);
    output_z_.FreeTensor(z_local);
  }

  AscendC::TPipe pipe_;
  AscendC::TQue<AscendC::TPosition::VECIN, kBufferNum> input_x_;
  AscendC::TQue<AscendC::TPosition::VECIN, kBufferNum> input_y_;
  AscendC::TQue<AscendC::TPosition::VECOUT, kBufferNum> output_z_;
  AscendC::GlobalTensor<float> x_gm_;
  AscendC::GlobalTensor<float> y_gm_;
  AscendC::GlobalTensor<float> z_gm_;
  int32_t tile_length_{0};
};

extern "C" __global__ __aicore__ void add_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  KernelAdd op;
  op.Init(x, y, z);
  op.Process();
}
